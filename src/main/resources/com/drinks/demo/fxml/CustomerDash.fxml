<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.drinks.demo.controller.CustomerDashController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Customer Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <HBox spacing="10">
            <Label text="Select Branch:"/>
            <ComboBox fx:id="branchSelector" prefWidth="200"/>
        </HBox>

        <Button text="Make Order" onAction="#handleMakeOrder" prefWidth="200"/>
        <Button text="Proceed to Payment" onAction="#handlePayment" prefWidth="200"/>
        <Button text="Back to Admin" onAction="#handleBackToAdmin" prefWidth="200"/>
    </VBox>

</AnchorPane>
