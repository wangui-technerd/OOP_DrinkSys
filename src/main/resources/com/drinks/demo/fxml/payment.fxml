<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drinks.demo.controller.PaymentController"
            prefWidth="600" prefHeight="400">

    <VBox AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

    <Label text="Payment Details" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox spacing="10">
            <Label text="Order ID:"/>
            <Label fx:id="orderId"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Customer:"/>
            <Label fx:id="customerName"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Total Amount:"/>
            <Label fx:id="totalAmount"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Payment Method:"/>
            <ComboBox fx:id="paymentMethod" prefWidth="200"/>
        </HBox>

        <HBox spacing="20">
            <Button text="Submit Payment" onAction="#submitPayment" />
            <Button text="Back" onAction="#goBackToOrder" />
        </HBox>
    </VBox>
</AnchorPane>
