<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.drinks.demo.controller.PaymentController"
      spacing="20"
      styleClass="root">

    <!-- Header -->
    <Label text="Complete Payment"
           styleClass="payment-header"
           maxWidth="Infinity" alignment="CENTER"/>

    <!-- Container -->
    <VBox styleClass="payment-box">

        <Label text="Order Payment" styleClass="section-label"/>

        <!-- Summary -->
        <VBox>
            <HBox styleClass="order-summary-row">
                <Label text="Customer:"/>
                <Label fx:id="customerName" text="Hafsa"/>
            </HBox>
            <HBox styleClass="order-summary-row">
                <Label text="Order ID:"/>
                <Label fx:id="orderId" text="ORD-00123"/>
            </HBox>
            <HBox styleClass="order-summary-row">
                <Label text="Total:"/>
                <Label fx:id="totalAmount" text="6,800"/>
                <Label text="KES"/>
            </HBox>
        </VBox>

        <!-- Payment Method Section -->
        <VBox spacing="12">
            <Label text="Select Payment Method:"/>
            <ComboBox fx:id="paymentMethod" promptText="Select a payment method"/>

            <Label text="Transaction Code (if paid):"/>
            <TextField fx:id="transactionCode" promptText="e.g. MPESA123XYZ"/>
        </VBox>

        <!-- Submit Button -->
        <Button text="Confirm &amp; Submit"
                styleClass="submit-button"
                onAction="#submitPayment"/>
    </VBox>
</VBox>
