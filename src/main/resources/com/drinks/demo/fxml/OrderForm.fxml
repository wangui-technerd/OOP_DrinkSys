<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.drinks.demo.controller.OrderFormController"
      spacing="20" alignment="TOP_CENTER"
      style="-fx-background-color: #fdf6f1;">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Drink Shop - Place your Order"
           style="-fx-background-color: #5e3a2e; -fx-text-fill: white; -fx-font-size: 20px;"
           maxWidth="Infinity" alignment="CENTER" />

    <HBox alignment="CENTER" spacing="10">
        <Label text="Select Branch:"/>
        <ComboBox fx:id="branchSelector" promptText="Select Branch"/>
    </HBox>
    <Label fx:id="branchNotice" text="Please select a branch to start ordering."
           style="-fx-text-fill: red;"/>

    <VBox fx:id="orderSection" visible="false" spacing="20">

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8;">
            <Label text="Drink Type:"/>
            <ComboBox fx:id="drinkTypeCombo" promptText="Select Type"/>
            <Label text="Brand:"/>
            <ComboBox fx:id="drinkBrandCombo" promptText="Select Brand"/>
            <Label text="Qty:"/>
            <TextField fx:id="qtyField" promptText="Qty" maxWidth="60"/>
            <Button text="Add" onAction="#addDrink"/>
        </HBox>

        <VBox spacing="10" style="-fx-background-color: #fff7f0; -fx-padding: 10; -fx-border-radius: 8;">
            <Label text="Order Summary"/>
            <ListView fx:id="orderList" />
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label text="Total: "/>
                <Label fx:id="totalCost" text="0" />
                <Label text=" KES"/>
            </HBox>
            <Button text="Place Order" style="-fx-background-color: #5e3a2e; -fx-text-fill: white;" onAction="#placeOrder"/>
        </VBox>
    </VBox>
</VBox>
